# ===================================================
# Factor Execution Terminal — Environment Configuration
# ===================================================

# Optional: Remote ARB-BOT bridge URL (e.g. deployed on Railway, Render, Fly.io, or VPS)
# When set, the frontend connects to $VITE_BACKEND_URL/api and $VITE_BACKEND_URL/api/stream.
# If omitted or running locally, defaults to http://localhost:3001 in dev.
# If deployed on Vercel without this variable, runs in standalone client mode.
VITE_BACKEND_URL=http://localhost:3001

# Fine-grained endpoint overrides (optional)
# VITE_API_BASE_URL=http://localhost:3001/api
# VITE_SSE_STREAM_URL=http://localhost:3001/api/stream
